# Git history and remote updates are reserved for the user.
prefix_rule(
    pattern = ["git", ["commit", "push"]],
    decision = "forbidden",
    justification = "Git commit and push are reserved for the user. Ask them to run the command.",
    match = [
        "git commit -m message",
        "git push origin main",
    ],
    not_match = [
        "git status",
        "git diff",
        "git add file.txt",
    ],
)
